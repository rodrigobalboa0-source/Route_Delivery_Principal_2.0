# Copie para .env e preencha com valores reais.

# Supabase do próprio RouteDelivery (Settings -> API no dashboard do projeto)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legado — Mapbox e Google Maps (SDK visual não é mais usado depois da
# migração pra Maps API própria; GOOGLE_MAPS_API_KEY ainda é lido pelo
# GoogleMapsKeyContext.tsx, que continua no ar como fallback, ver
# ~/maps-api/plano-integracao-routedelivery.md)
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Maps API própria (~/maps-api) — geocoding, autocomplete e mapa (Leaflet)
# via MapViewOwnApi.tsx. Local: http://localhost:3000 rodando o backend da
# maps-api. A chave é a mesma cadastrada na tabela api_keys do projeto
# Supabase da maps-api (não confundir com a anon key acima, que é de um
# projeto Supabase diferente).
VITE_MAPS_API_URL=http://localhost:3000
VITE_MAPS_API_KEY=
