############################################################
# RouteDelivery — Supabase Self-Hosted
# Copie este arquivo para .env e preencha os valores
############################################################

# ─── Banco de Dados ────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# GERE UMA SENHA FORTE — não reutilize a senha do Supabase Cloud
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI

# ─── JWT ───────────────────────────────────────────────────
# Mínimo 32 caracteres. Gere com: openssl rand -base64 32
JWT_SECRET=TROQUE_POR_JWT_SECRET_DE_32_CHARS
JWT_EXPIRY=3600

# ANON_KEY e SERVICE_ROLE_KEY são JWTs assinados com JWT_SECRET acima.
# Depois de definir JWT_SECRET, gere novos tokens em:
#   https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# Ou use o script scripts/generate-keys.sh
ANON_KEY=GERAR_COM_JWT_SECRET
SERVICE_ROLE_KEY=GERAR_COM_JWT_SECRET

# ─── URLs Públicas ─────────────────────────────────────────
# IP ou domínio do servidor (sem barra final)
SITE_URL=http://SEU_IP_OU_DOMINIO
API_EXTERNAL_URL=http://SEU_IP_OU_DOMINIO:8000
SUPABASE_PUBLIC_URL=http://SEU_IP_OU_DOMINIO:8000
ADDITIONAL_REDIRECT_URLS=

# ─── Portas ────────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3000

# ─── Dashboard Supabase Studio ─────────────────────────────
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=TROQUE_POR_SENHA_DASHBOARD

# ─── Email / SMTP ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=routedeelivery@gmail.com
SMTP_PASS=SENHA_APP_GMAIL
SMTP_ADMIN_EMAIL=routedeelivery@gmail.com
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
DISABLE_SIGNUP=false

# ─── Realtime ──────────────────────────────────────────────
# Gere com: openssl rand -base64 64
REALTIME_SECRET_KEY_BASE=GERAR_COM_OPENSSL

# ─── Imagens ───────────────────────────────────────────────
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ─── SQLAdmin (substitui o Supabase Studio) ────────────────
SQLADMIN_PORT=4000
# Acesso em http://SEU_IP:4000

# ─── App React (.env da aplicação após migrar) ─────────────
# Após subir o servidor, atualize o .env do projeto React:
# VITE_SUPABASE_URL=http://SEU_IP_OU_DOMINIO:8000
# VITE_SUPABASE_ANON_KEY=<novo ANON_KEY>
# VITE_GOOGLE_MAPS_API_KEY=AIzaSyAk_GTBnUcLRLd2gVusUZRzvAxm5hefdpo
# VITE_GOOGLE_MAPS_MAP_ID=da75f8800318c91f365f94fc
